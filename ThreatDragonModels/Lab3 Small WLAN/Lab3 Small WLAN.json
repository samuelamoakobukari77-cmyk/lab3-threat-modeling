                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering",
                  "description": "Malware on a compromised client encrypts or modifies files on the NAS. Vulnerability: shared write access and no backups.",
                  "mitigation": "Apply least-privilege permissions, keep regular offline backups, and patch and run antivirus on clients.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 7,
                  "score": "7"
                }
