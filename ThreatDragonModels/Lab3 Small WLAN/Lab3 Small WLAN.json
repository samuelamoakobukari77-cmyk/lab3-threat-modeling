                  "title": "Unauthorized access to NAS files",
                  "status": "Open",
                  "severity": "High",
                  "type": "Information disclosure",
                  "description": "Any device on the WLAN can reach the NAS, and weak or default NAS credentials let an attacker read shared files.",
                  "mitigation": "Use strong unique NAS credentials, per-user access control, disable unused services, and encrypt shares.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 6,
                  "score": "8"
