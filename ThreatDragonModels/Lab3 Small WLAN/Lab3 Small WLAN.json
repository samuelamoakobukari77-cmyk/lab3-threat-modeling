                {
                  "id": "d531d586-dd8b-4523-80c8-3d9489912435",
                  "title": "Evil twin access point",
                  "status": "Open",
                  "severity": "High",
                  "type": "Spoofing",
                  "description": "An attacker sets up a rogue AP with the same SSID. Clients connect automatically, letting the attacker capture credentials and traffic. Vulnerability: WPA2-PSK with a shared passphrase and no AP authentication.",
                  "mitigation": "Use WPA3-SAE or WPA2-Enterprise, verify the SSID/BSSID, train users not to join unknown networks, and use a VPN on untrusted networks.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 1,
                  "score": "7"
                },
                {
                  "id": "bc3faccb-b774-4aff-b56c-894c8c6978ac",
                  "title": "Default admin credentials",
                  "status": "Open",
                  "severity": "High",
                  "type": "Elevation of privilege",
                  "description": "Router uses default admin credentials and outdated firmware, so an attacker can take full control of the network.",
                  "mitigation": "Change default admin credentials, update firmware, disable remote administration and WPS.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 2,
                  "score": "9"
                },
                {
                  "id": "3d62da4d-8c6a-462d-87c9-5231fe6040f4",
                  "title": "Deauthentication flood",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Denial of service",
                  "description": "Attacker sends forged deauthentication frames and repeatedly disconnects clients. Vulnerability: management frames are unprotected (no 802.11w).",
                  "mitigation": "Enable 802.11w (PMF) and WPA3, and monitor with a wireless IDS.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": "5"
                }
